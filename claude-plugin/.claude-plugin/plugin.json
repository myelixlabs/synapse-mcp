{
  "name": "synapse-mcp",
  "displayName": "Synapse MCP",
  "version": "4.3.0",
  "description": "A persistent code-knowledge graph for AI agents. Runs locally. Writes safely.",
  "author": {
    "name": "Myelix Labs",
    "email": "hello@myelixlabs.com",
    "url": "https://synapse-mcp.dev"
  },
  "homepage": "https://synapse-mcp.dev",
  "privacyPolicyUrl": "https://synapse-mcp.dev/privacy",
  "repository": "https://github.com/myelixlabs/synapse-mcp",
  "license": "MIT",
  "keywords": [
    "mcp",
    "ast",
    "codebase-graph",
    "refactoring",
    "safe-writes",
    "token-savings",
    "code-review"
  ],
  "mcpServers": {
    "synapse": {
      "type": "http",
      "url": "${user_config.synapse_url}"
    }
  },
  "userConfig": {
    "synapse_url": {
      "type": "string",
      "title": "Synapse MCP URL",
      "description": "Where the Synapse MCP server installed on this machine listens. Keep the default unless you started Synapse on another port.",
      "default": "http://127.0.0.1:8585"
    }
  }
}
